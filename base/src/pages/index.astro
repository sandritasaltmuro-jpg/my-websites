---
/**
 * Página de inicio (provisional).
 * Solo comprueba que el proyecto funciona; se sustituirá por los componentes de la semana 2.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Base webs · Plantilla madre"
  description="Proyecto base con estructura común, SEO y temas por sector para crear webs de pequeños negocios."
>
  <section class="container hola">
    <h1>Tu base está funcionando</h1>
    <p>
      Esta es la plantilla madre. Desde aquí saldrán los conceptos de cada sector y las webs de tus clientes.
    </p>
    <p class="nota">Próximo paso: semana 2, tokens y componentes base.</p>
  </section>
</BaseLayout>

<style>
  /* Estilos solo de esta página */
  .hola {
    padding-block: var(--space-9);
  }
  .hola h1 {
    font-size: var(--text-4xl);
  }
  .nota {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
