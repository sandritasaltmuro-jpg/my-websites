---
/**
 * index.astro — Página de la BASE (infraestructura común, sin diseño).
 * La base no es una web para enseñar: es el punto de partida de cada kit de sector.
 * Esta página solo comprueba que el SEO y los datos del negocio funcionan.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { fullAddress } from '../utils/contact';
---

<BaseLayout title={`Base · ${site.name}`} description={site.description} noindex>
  <section class="container container--narrow info">
    <h1>Base común</h1>
    <p>
      Infraestructura invisible que comparten todas las webs: SEO, datos del negocio, datos para Google,
      accesibilidad, páginas legales, 404, robots.txt y sitemap.
    </p>
    <p>El diseño (cabecera, secciones, pie) vive en cada kit de sector: <code>sectores/gym</code>, <code>sectores/belleza</code>…</p>

    <h2>Datos cargados desde site.ts</h2>
    <ul>
      <li>Negocio: {site.name}</li>
      <li>Dirección: {fullAddress()}</li>
      <li>Teléfono: {site.contact.phone}</li>
      <li>Tipo para Google: {site.schemaType}</li>
    </ul>
  </section>
</BaseLayout>

<style>
  .info { padding-block: var(--space-8); }
</style>
