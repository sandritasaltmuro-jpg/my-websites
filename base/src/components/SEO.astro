---
/**
 * SEO.astro — Etiquetas del <head> para buscadores y para compartir en redes / WhatsApp.
 * Cada página pasa su propio título y descripción (nunca repetidos entre páginas).
 * Si no se pasan, usa los de site.ts.
 *
 * Fórmula del título (ver claude/seo-bases.md):
 *   "Palabra clave principal en Zona | Nombre del negocio"  (50–60 caracteres)
 */
import { site } from '../config/site';

interface Props {
  title?: string;         // 50–60 caracteres
  description?: string;   // 140–160 caracteres
  image?: string;         // Imagen para compartir (1200x630), ruta dentro de /public
  noindex?: boolean;      // true en páginas que no deben salir en Google
}

const {
  title = site.name,
  description = site.description,
  image = site.ogImage,
  noindex = site.noindex,
} = Astro.props;

// URL canónica siempre con el dominio final (nunca la de vista previa de Vercel)
const canonical = new URL(Astro.url.pathname, site.url);
const ogImage = image ? new URL(image, site.url) : null;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph: cómo se ve el enlace al compartirlo -->
<meta property="og:type" content="website" />
<meta property="og:locale" content="es_ES" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:width" content="1200" />}
{ogImage && <meta property="og:image:height" content="630" />}
<meta name="twitter:card" content="summary_large_image" />
