---
/**
 * Footer.astro — Datos del negocio (NAP) en texto en todas las páginas,
 * horario resumido, redes y enlaces legales. Todo desde site.ts.
 */
import { site } from '../config/site';
import { fullAddress, phoneUrl, emailUrl, whatsappUrl } from '../utils/contact';
import Icon from './Icon.astro';

const socials = [
  { name: 'Instagram', icon: 'instagram', url: site.social.instagram },
  { name: 'Facebook', icon: 'facebook', url: site.social.facebook },
  { name: 'TikTok', icon: 'tiktok', url: site.social.tiktok },
].filter((s) => s.url) as { name: string; icon: 'instagram' | 'facebook' | 'tiktok'; url: string }[];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <p class="site-footer__name">{site.name}</p>
      <address>
        {fullAddress()}<br />
        <a href={phoneUrl()}>{site.contact.phone}</a><br />
        <a href={emailUrl()}>{site.contact.email}</a><br />
        <a href={whatsappUrl()} target="_blank" rel="noopener">WhatsApp<span class="sr-only"> (se abre en una pestaña nueva)</span></a>
      </address>
    </div>

    <div>
      <p class="site-footer__heading">Horario</p>
      <ul role="list">
        {site.hours.map((h) => <li>{h.label}: {h.opens}–{h.closes}</li>)}
        {site.closedLabel && <li>{site.closedLabel}</li>}
      </ul>
    </div>

    {socials.length > 0 && (
      <div>
        <p class="site-footer__heading">Síguenos</p>
        <ul class="site-footer__social" role="list">
          {socials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener">
                <Icon name={s.icon} />
                <span class="sr-only">{s.name} (se abre en una pestaña nueva)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <div class="container site-footer__bottom">
    <p>© {year} {site.name}</p>
    <ul role="list">
      <li><a href="/aviso-legal/">Aviso legal</a></li>
      <li><a href="/privacidad/">Privacidad</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-8) var(--space-5);
    background: var(--color-text);
    color: var(--color-bg);
    font-size: var(--text-sm);
  }
  .site-footer a { color: inherit; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; }
  .site-footer__grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .site-footer__name {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-3);
  }
  .site-footer__heading { font-weight: var(--weight-bold); margin-bottom: var(--space-3); }
  address { font-style: normal; line-height: 1.9; }
  .site-footer__social { display: flex; gap: var(--space-2); }
  .site-footer__social a {
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid color-mix(in srgb, currentColor 25%, transparent);
  }
  .site-footer__bottom p { margin: 0; }
  .site-footer__bottom ul { display: flex; gap: var(--space-5); }
</style>
