---
/**
 * Hero.astro — Primera pantalla. Lleva el ÚNICO H1 de la página.
 * El H1 debe incluir la palabra clave principal (ver claude/seo-bases.md).
 * La imagen, si hay, se carga con prioridad (mejora el LCP).
 *
 * Uso:
 *   <Hero
 *     eyebrow="Peluquería en Chamberí"
 *     title="Cortes y color que duran"
 *     text="Entradilla corta con la propuesta de valor."
 *     image={heroImg} imageAlt="Descripción de la foto"
 *   />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';
import { whatsappUrl } from '../utils/contact';

interface Props {
  title: string;
  eyebrow?: string;
  text?: string;
  image?: ImageMetadata;
  /** Obligatorio si hay imagen: describe lo que se ve */
  imageAlt?: string;
  /** Acción principal (por defecto: WhatsApp) */
  primaryLabel?: string;
  primaryHref?: string;
  /** Acción secundaria opcional (por ejemplo, ver servicios) */
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title,
  eyebrow,
  text,
  image,
  imageAlt = '',
  primaryLabel = 'Escríbenos por WhatsApp',
  primaryHref = whatsappUrl(),
  secondaryLabel,
  secondaryHref,
} = Astro.props;
const primaryIsWhatsapp = primaryHref.startsWith('https://wa.me');
---

<section class:list={['hero', { 'hero--image': image }]}>
  <div class="container hero__inner">
    <div class="hero__content">
      {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}
      <h1 class="hero__title">{title}</h1>
      {text && <p class="hero__text">{text}</p>}
      <div class="hero__actions">
        <Button
          href={primaryHref}
          variant={primaryIsWhatsapp ? 'whatsapp' : 'primary'}
          icon={primaryIsWhatsapp ? 'whatsapp' : undefined}
        >{primaryLabel}</Button>
        {secondaryLabel && secondaryHref && (
          <Button href={secondaryHref} variant="secondary">{secondaryLabel}</Button>
        )}
      </div>
    </div>

    {image && (
      <div class="hero__media">
        <Image
          src={image}
          alt={imageAlt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 56rem) 50vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )}
  </div>
</section>

<style>
  .hero { padding-block: var(--space-8) var(--section-space); }
  .hero__inner { display: grid; gap: var(--space-7); align-items: center; }
  .hero__eyebrow {
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .hero__title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    margin-bottom: var(--space-5);
  }
  .hero__text { font-size: var(--text-lg); color: var(--color-muted); margin-bottom: var(--space-6); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .hero__media img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }

  @media (min-width: 56rem) {
    .hero--image .hero__inner { grid-template-columns: 1.1fr 0.9fr; }
  }
</style>
