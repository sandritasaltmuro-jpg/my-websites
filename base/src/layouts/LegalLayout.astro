---
/**
 * LegalLayout.astro — Plantilla sencilla para textos legales (aviso legal, privacidad).
 * Texto estrecho y legible. Cada kit puede añadir su cabecera y pie con los slots.
 */
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
}
const { title, description, heading } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Fragment slot="header"><slot name="header" /></Fragment>
  <article class="container container--narrow legal">
    <p><a href="/">← Volver al inicio</a></p>
    <h1>{heading}</h1>
    <slot />
  </article>
  <Fragment slot="footer"><slot name="footer" /></Fragment>
</BaseLayout>

<style>
  .legal { padding-block: var(--space-8); }
  .legal :global(h2) { font-size: var(--text-xl); margin-top: var(--space-7); }
</style>
