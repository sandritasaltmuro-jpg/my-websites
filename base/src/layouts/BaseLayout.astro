---
/**
 * BaseLayout.astro — Estructura común e INVISIBLE de todas las webs:
 * <head> con SEO y datos para Google, enlace "Saltar al contenido" y <main>.
 *
 * La cabecera y el pie los pone cada kit de sector (diseño propio) con los slots:
 *   <BaseLayout title="..." description="...">
 *     <Header slot="header" />
 *     ...secciones...
 *     <Footer slot="footer" />
 *   </BaseLayout>
 */
import SEO from '../components/SEO.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import '../styles/tokens.css';
import '../styles/base.css';
// Tema activo (en la base: neutro). Cada kit de sector importa el suyo.
import '../themes/neutro.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const seo = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO {...seo} />
    <LocalBusinessSchema />
    <!-- Fuentes del tema u otras etiquetas de una página concreta -->
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot name="header" />
    <main id="contenido">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
