---
/**
 * Testimonials.astro — Opiniones reales de clientes (siempre con su permiso).
 * No se marcan con datos estructurados de valoraciones: Google no lo admite
 * para opiniones publicadas por el propio negocio.
 *
 * Uso:
 *   <Testimonials items={[{ quote: '...', name: 'Laura M.', detail: 'Clienta desde 2023' }]} />
 */
interface Item {
  quote: string;
  name: string;
  detail?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<ul class="testimonials" role="list">
  {items.map((item) => (
    <li>
      <figure class="testimonial">
        <blockquote><p>“{item.quote}”</p></blockquote>
        <figcaption>
          <strong>{item.name}</strong>
          {item.detail && <span>{item.detail}</span>}
        </figcaption>
      </figure>
    </li>
  ))}
</ul>

<style>
  .testimonials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .testimonial {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .testimonial blockquote { margin: 0; }
  .testimonial blockquote p { font-size: var(--text-lg); margin: 0; }
  .testimonial figcaption { display: flex; flex-direction: column; font-size: var(--text-sm); }
  .testimonial figcaption span { color: var(--color-muted); }
</style>
