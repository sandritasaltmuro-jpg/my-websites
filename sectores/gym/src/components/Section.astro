---
/**
 * Section.astro — Envoltorio de sección con su H2.
 * Cada sección lleva un id (para el menú) y un título H2 (para SEO y lectores de pantalla).
 *
 * Uso:
 *   <Section id="servicios" eyebrow="Lo que hacemos" title="Servicios" intro="Texto opcional">
 *     ...contenido...
 *   </Section>
 */
interface Props {
  id: string;
  title: string;
  /** Texto pequeño encima del título (opcional) */
  eyebrow?: string;
  /** Entradilla bajo el título (opcional) */
  intro?: string;
  /** Fondo alterno para separar secciones */
  alt?: boolean;
  /** Contenido más estrecho (textos largos, FAQ) */
  narrow?: boolean;
}
const { id, title, eyebrow, intro, alt = false, narrow = false } = Astro.props;
const headingId = `${id}-titulo`;
---

<section id={id} class:list={['section', { 'section--alt': alt }]} aria-labelledby={headingId}>
  <div class:list={['container', { 'container--narrow': narrow }]}>
    <header class="section__header">
      {eyebrow && <p class="section__eyebrow">{eyebrow}</p>}
      <h2 id={headingId}>{title}</h2>
      {intro && <p class="section__intro">{intro}</p>}
    </header>
    <slot />
  </div>
</section>

<style>
  .section { padding-block: var(--section-space); }
  .section--alt { background: var(--color-surface-alt); }
  .section__header { margin-bottom: var(--space-7); max-width: var(--measure); }
  .section__eyebrow {
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .section__intro { font-size: var(--text-lg); color: var(--color-muted); margin-bottom: 0; }
</style>
