---
/**
 * FilmImage.astro (kit gym) — Foto con el efecto película analógica de Brava.
 * ---------------------------------------------------------------------------
 * - Busca la foto por su NÚMERO en src/assets/brava/ (p. ej. "01" → 01-hero-sentadilla.png).
 *   Así basta con dejar el archivo en la carpeta: no hay que tocar el código.
 * - Aplica el filtro (--film-filter) y el grano (--film-grain) del tema.
 * - Si la foto todavía no existe, pinta un marcador de posición con los colores
 *   del tema y el número de la foto que falta (nunca imágenes de internet).
 * - Ocupa todo su contenedor (object-fit: cover): el tamaño lo decide el padre.
 *
 * Uso:
 *   <FilmImage num="01" alt="Mujer haciendo una sentadilla…" priority />
 *   <FilmImage num="02" alt="" sizes="120px" />   ← alt="" si es decorativa
 *
 * priority = foto del hero: carga inmediata, prioridad alta y la espera la pantalla de carga.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Número de la foto (dos cifras), según docs/brava-concepto.md, Parte 3 */
  num: string;
  /** Texto alternativo. Vacío ("") si la foto es decorativa */
  alt: string;
  /** Tamaño en pantalla, para que el navegador elija la versión justa */
  sizes?: string;
  /** Anchos que se generan (en píxeles) */
  widths?: number[];
  /** Foto principal de la página (hero) */
  priority?: boolean;
  /** Encuadre de la foto: qué parte se conserva al recortar (CSS object-position) */
  position?: string;
  class?: string;
}

const {
  num,
  alt,
  sizes = '100vw',
  widths = [480, 800, 1200, 1600, 2400],
  priority = false,
  position = 'center',
  class: className = '',
} = Astro.props;

// Todas las fotos de la carpeta; se elige la que empieza por el número pedido
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/brava/*.{png,jpg,jpeg,webp,avif}', { eager: true });
const match = Object.entries(files).find(([path]) => path.split('/').pop()!.startsWith(`${num}-`));
const src = match?.[1].default;

// Solo se pueden pedir anchos que la foto original tenga
const usableWidths = src ? widths.filter((w) => w <= src.width) : [];
---

<div class:list={['film', className, { 'film--placeholder': !src }]} style={`--film-position: ${position}`}>
  {src ? (
    <Image
      src={src}
      alt={alt}
      widths={usableWidths.length ? usableWidths : [src.width]}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
      data-preload={priority ? '' : undefined}
    />
  ) : (
    // Marcador de posición: decorativo para lectores de pantalla
    <span class="film__missing" aria-hidden="true">Foto {num}</span>
  )}
</div>

<style>
  .film {
    position: relative;
    overflow: hidden;
    background: var(--gradient-heat);
  }
  .film img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--film-position, center);
    filter: var(--film-filter);
  }
  /* Grano de película por encima de la foto (no captura clics) */
  .film::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--film-grain);
    background-size: 160px;
    opacity: var(--film-grain-opacity);
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  /* Marcador de posición mientras no esté la foto */
  .film__missing {
    position: absolute;
    right: var(--space-2);
    bottom: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brava-cream);
    opacity: 0.6;
  }
</style>
