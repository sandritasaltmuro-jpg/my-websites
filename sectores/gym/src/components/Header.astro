---
/**
 * Header.astro (kit gym · Brava) — Cabecera fija y TRANSPARENTE sobre el Hero.
 * ---------------------------------------------------------------------------
 * - Arriba del todo es transparente: se ve la foto del Hero detrás.
 * - Al bajar, se rellena de borgoña con una línea fina para que el menú se lea
 *   sobre cualquier sección (clase .is-scrolled, la pone el script).
 * - Tipografía: Space Mono en mayúsculas (la misma de las etiquetas del Hero),
 *   tanto el logo como el menú. Sin botón: la reserva va por el botón flotante.
 * - Móvil: botón de menú accesible (aria-expanded) que abre un panel a pantalla
 *   completa; se cierra con Escape, al elegir un enlace o al volver a pulsar.
 *
 * Datos: site.name y site.nav (src/config/site.ts).
 * Altura: --header-h (4rem). Las páginas dejan ese hueco arriba (ver base.css)
 * y el Hero se mete debajo para que la cabecera quede encima de la foto.
 */
import { site } from '../config/site';
import Icon from './Icon.astro';
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <a href="/" class="site-header__logo">{site.name}</a>

    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu-principal"
      data-menu-toggle
    >
      <span class="icon-open"><Icon name="menu" size={24} /></span>
      <span class="icon-close"><Icon name="close" size={24} /></span>
      <span class="sr-only">Abrir o cerrar el menú</span>
    </button>

    <nav id="menu-principal" class="site-header__nav" aria-label="Principal" data-menu>
      <ul role="list">
        {site.nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  // Fondo borgoña en cuanto se baja un poco (arriba del todo, transparente)
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Menú móvil: abre/cierra y mantiene aria-expanded al día
  function setOpen(open: boolean) {
    toggle?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('is-open', open);
    header?.classList.toggle('menu-open', open);
    document.body.style.overflow = open ? 'hidden' : ''; // sin scroll detrás del panel
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });
  // Cerrar al elegir un enlace (one-page con anclas)
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  // Cerrar con Escape y devolver el foco al botón
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    color: var(--color-text);
    /* Transparente arriba; borde invisible para que no salte al rellenarse */
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color var(--duration-slow) var(--ease), border-color var(--duration-slow) var(--ease);
  }
  .site-header.is-scrolled,
  .site-header.menu-open {
    background: var(--color-bg);
    border-bottom-color: var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    height: var(--header-h);
    /* Mismos márgenes que el Hero: el logo cae encima de las etiquetas y del titular */
    padding-inline: var(--space-5);
  }

  /* Logo: Space Mono en mayúsculas, como "GIMNASIO PARA MUJERES" del Hero */
  .site-header__logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
  }

  /* Botón de menú (solo móvil) */
  .site-header__toggle {
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    margin-right: calc(-1 * var(--space-2));
    border: 0;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }
  .site-header__toggle .icon-close { display: none; }
  .site-header__toggle[aria-expanded='true'] .icon-open { display: none; }
  .site-header__toggle[aria-expanded='true'] .icon-close { display: block; }

  /* Enlaces del menú: Space Mono en mayúsculas, como las etiquetas del Hero */
  .site-header__nav ul { list-style: none; margin: 0; padding: 0; }
  .site-header__nav li a {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    text-underline-offset: 0.35em;
  }
  .site-header__nav li a:hover { text-decoration: underline; }


  /* ---- Móvil: panel a pantalla completa bajo la cabecera ---- */
  @media (max-width: 63.99rem) {
    .site-header__nav {
      display: none;
      position: fixed;
      inset: var(--header-h) 0 0 0;
      padding: var(--space-6) var(--space-5);
      background: var(--color-bg);
      overflow-y: auto;
    }
    .site-header__nav.is-open {
      display: flex;
      flex-direction: column;
    }
    /* En el panel, enlaces más grandes y separados por líneas finas */
    .site-header__nav li { border-bottom: 1px solid var(--color-border); }
    .site-header__nav li a {
      min-height: 3.5rem;
      font-size: var(--text-base);
    }
  }

  @media (min-width: 48rem) {
    .site-header__inner { padding-inline: var(--space-7); }
  }

  /* ---- Escritorio: menú en línea ---- */
  @media (min-width: 64rem) {
    .site-header__toggle { display: none; }
    .site-header__nav {
      display: flex;
      align-items: center;
      gap: var(--space-6);
    }
    .site-header__nav ul { display: flex; gap: var(--space-6); }
  }
</style>
