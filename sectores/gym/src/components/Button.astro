---
/**
 * Button.astro — Botón-enlace. Los textos empiezan por verbo ("Pide cita", "Escríbenos").
 *
 * Variantes:
 *  - primary:   acción principal (una por sección como mucho)
 *  - secondary: acción secundaria, con borde
 *  - whatsapp:  verde de WhatsApp, reconocible al instante
 *
 * Uso: <Button href={whatsappUrl()} variant="whatsapp" icon="whatsapp">Escríbenos por WhatsApp</Button>
 */
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'whatsapp';
  icon?: 'whatsapp' | 'phone' | 'mail' | 'arrow';
  /** true para enlaces que salen de la web (WhatsApp, mapas…): se abren en pestaña nueva */
  external?: boolean;
  class?: string;
}
const { href, variant = 'primary', icon, external = false, class: className } = Astro.props;
const isExternal = external || href.startsWith('https://wa.me');
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, className]}
  {...(isExternal ? { target: '_blank', rel: 'noopener' } : {})}
>
  {icon && <Icon name={icon} />}
  <span><slot /></span>
  {isExternal && <span class="sr-only">(se abre en una pestaña nueva)</span>}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding: var(--space-3) var(--space-5);
    border: 2px solid transparent;
    border-radius: var(--radius);
    font-weight: var(--weight-bold);
    text-decoration: none;
    line-height: 1.2;
    transition: transform var(--duration-fast) var(--ease), background-color var(--duration-fast) var(--ease);
  }
  .btn:hover { transform: translateY(-1px); }
  .btn:active { transform: translateY(0); }

  .btn--primary { background: var(--color-primary); color: var(--color-on-primary); }
  .btn--primary:hover { filter: brightness(1.1); }

  .btn--secondary { border-color: currentColor; color: var(--color-text); background: transparent; }
  .btn--secondary:hover { background: var(--color-surface-alt); }

  /* Verde oscuro de WhatsApp: texto blanco con contraste suficiente (5.4:1) */
  .btn--whatsapp { background: #0e7a41; color: #ffffff; }
  .btn--whatsapp:hover { background: #0b6636; }
</style>
