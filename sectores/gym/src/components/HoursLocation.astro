---
/**
 * HoursLocation.astro — Horario + dirección + mapa.
 * Todo sale de site.ts, así coincide con el footer y con los datos para Google.
 *
 * El mapa NO se carga hasta que la persona pulsa "Ver mapa":
 *  - la página carga más rápido (mejor nota en PageSpeed)
 *  - Google Maps no instala cookies sin que el visitante lo pida (RGPD)
 */
import { site } from '../config/site';
import { fullAddress, mapEmbedUrl, mapLinkUrl } from '../utils/contact';
import Icon from './Icon.astro';
---

<div class="hours-location">
  <div class="hours-location__info">
    <h3><Icon name="clock" /> Horario</h3>
    <dl class="hours">
      {site.hours.map((h) => (
        <div class="hours__row">
          <dt>{h.label}</dt>
          <dd><time datetime={h.opens}>{h.opens}</time> – <time datetime={h.closes}>{h.closes}</time></dd>
        </div>
      ))}
    </dl>
    {site.closedLabel && <p class="hours__closed">{site.closedLabel}</p>}

    <h3><Icon name="pin" /> Dónde estamos</h3>
    <address>
      {fullAddress()}<br />
      {site.address.directions}
    </address>
    <a class="hours-location__link" href={mapLinkUrl()} target="_blank" rel="noopener">
      Cómo llegar en Google Maps<span class="sr-only"> (se abre en una pestaña nueva)</span>
    </a>
  </div>

  <div class="map" data-map data-src={mapEmbedUrl()}>
    <button type="button" class="map__load" data-map-load>
      <Icon name="pin" size={28} />
      <span>Ver mapa</span>
      <small>Se cargará Google Maps</small>
    </button>
  </div>
</div>

<script>
  // Carga el mapa solo al pulsar el botón
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
    map.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = map.dataset.src ?? '';
      iframe.title = 'Mapa con la ubicación del negocio';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      map.replaceChildren(iframe);
    });
  });
</script>

<style>
  .hours-location { display: grid; gap: var(--space-7); }
  .hours-location h3 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-lg);
    margin-top: var(--space-6);
  }
  .hours-location h3:first-child { margin-top: 0; }
  .hours { margin: 0; }
  .hours__row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .hours dd { margin: 0; font-family: var(--font-mono); font-size: var(--text-sm); }
  .hours__closed { margin-top: var(--space-3); color: var(--color-muted); }
  address { font-style: normal; margin-bottom: var(--space-3); }
  .hours-location__link { font-weight: var(--weight-medium); }

  .map {
    min-height: 20rem;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .map :global(iframe) { width: 100%; height: 100%; min-height: 20rem; border: 0; }
  .map__load {
    width: 100%;
    height: 100%;
    min-height: 20rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border: 0;
    background: transparent;
    color: var(--color-text);
    font-weight: var(--weight-bold);
    cursor: pointer;
  }
  .map__load small { font-weight: var(--weight-regular); color: var(--color-muted); }

  @media (min-width: 56rem) {
    .hours-location { grid-template-columns: 1fr 1.2fr; align-items: stretch; }
  }
</style>
