---
/**
 * Hero.astro (kit gym · Brava) — Primera pantalla con el ÚNICO H1 de la página.
 * ---------------------------------------------------------------------------
 * Composición (ref. editorial "foto a sangre + rejilla de líneas finas"):
 *   - Foto 01 a pantalla completa con efecto película, degradado y grano.
 *   - Arriba: etiquetas en mono; en el centro, el H1 en Space Mono.
 *   - Abajo, dividido por líneas finas:
 *       izquierda → mini carrusel de clases (foto, nombre, "Reservar", flechas y puntos)
 *       derecha   → entradilla
 *
 * Datos: textos por props (con los del concepto por defecto), clases de src/data/clases.ts
 * y WhatsApp de site.ts. Sin JavaScript el carrusel se puede deslizar igualmente
 * (scroll horizontal); el script solo añade flechas y puntos.
 *
 * Uso: <Hero />
 *
 * Contraste: el texto crema va siempre sobre los degradados oscuros de la foto
 * (--gradient-photo + --gradient-photo-bottom) o sobre borgoña/rojo intenso.
 */
import { site } from '../config/site';
import { whatsappUrl } from '../utils/contact';
import { clases } from '../data/clases';
import FilmImage from './FilmImage.astro';
import Icon from './Icon.astro';

interface Props {
  /** Primera parte del H1: lleva la palabra clave principal */
  title?: string;
  /** Segunda parte del H1, en línea aparte */
  tagline?: string;
  intro?: string;
}

const {
  title = 'Gimnasio para mujeres en Madrid.',
  tagline = 'Entrena brava.',
  intro = 'Hyrox, HIIT, barre, pole y clases hot en grupos reducidos. Y después, fisio, spa y sauna. Llegas como quieras; sales más fuerte.',
} = Astro.props;

// Coordenadas en formato de ficha (40°25′N 3°42′W) a partir de site.ts
function dms(value: number, pos: string, neg: string) {
  const abs = Math.abs(value);
  const deg = Math.floor(abs);
  const min = Math.round((abs - deg) * 60);
  return `${deg}°${String(min).padStart(2, '0')}′${value >= 0 ? pos : neg}`;
}
const coords = `${dms(site.geo.latitude, 'N', 'S')} ${dms(site.geo.longitude, 'E', 'W')}`;

const pad = (n: number) => String(n).padStart(2, '0');
const newTab = ' (se abre en una pestaña nueva)';
---

<section class="hero" aria-labelledby="hero-title">
  <!-- Fondo: foto a sangre con efecto película -->
  <div class="hero__bg" data-reveal="image">
    <FilmImage
      num="01"
      alt="Mujer haciendo una sentadilla de perfil con tacones transparentes y una mancuerna cromada"
      position="70% center"
      priority
    />
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__inner">
    <!-- Arriba: etiquetas y titular -->
    <div class="hero__top">
      <div class="hero__labels" data-reveal="up">
        <p>Gimnasio para mujeres · Malasaña, Madrid</p>
        <p aria-hidden="true">{coords}</p>
      </div>
      <h1 id="hero-title" class="hero__title" data-reveal="lines">
        {title} <span class="hero__tagline">{tagline}</span>
      </h1>
    </div>

    <!-- Abajo: pantalla dividida por líneas finas -->
    <div class="hero__bottom">
      <div
        class="hero__classes"
        role="region"
        aria-roledescription="carrusel"
        aria-label="Nuestras clases"
        data-carousel
        data-reveal="up"
      >
        <div class="hero__classes-head">
          <p class="hero__label">Clases</p>
          <div class="hero__controls" data-carousel-controls>
            <button type="button" class="hero__arrow hero__arrow--prev" data-carousel-prev aria-label="Clase anterior">
              <Icon name="arrow" size={18} />
            </button>
            <button type="button" class="hero__arrow" data-carousel-next aria-label="Clase siguiente">
              <Icon name="arrow" size={18} />
            </button>
          </div>
        </div>

        <ul class="hero__track" role="list" data-carousel-track>
          {clases.map((c, i) => (
            <li
              class="hero__slide"
              role="group"
              aria-roledescription="diapositiva"
              aria-label={`${i + 1} de ${clases.length}: ${c.name}`}
            >
              <FilmImage num={c.photo} alt={c.alt} sizes="112px" widths={[224, 336]} class="hero__thumb" />
              <div class="hero__slide-text">
                <p class="hero__slide-name">
                  <span class="hero__slide-num" aria-hidden="true">{pad(i + 1)}</span>
                  {c.name}
                </p>
                <p class="hero__slide-meta">{c.meta}</p>
                <a
                  class="hero__book"
                  href={whatsappUrl(`Hola, quiero reservar una clase de ${c.name} en ${site.name}.`)}
                  target="_blank"
                  rel="noopener"
                >
                  Reservar<span class="sr-only"> {c.name} por WhatsApp{newTab}</span>
                </a>
              </div>
            </li>
          ))}
        </ul>

        <div class="hero__dots" data-carousel-dots>
          {clases.map((c, i) => (
            <button type="button" class="hero__dot" aria-label={`Ver ${c.name}`} aria-current={i === 0 ? 'true' : undefined}></button>
          ))}
        </div>
      </div>

      <div class="hero__pitch">
        <p class="hero__intro" data-reveal="up">{intro}</p>
      </div>
    </div>
  </div>
</section>

<script>
  /**
   * Mini carrusel del Hero: flechas y puntos sobre un scroll horizontal nativo.
   * Sin este script se puede deslizar igual (dedo, trackpad o teclado).
   * No avanza solo: lo mueve quien lo usa.
   */
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const slides = [...(track?.children ?? [])] as HTMLElement[];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-carousel-dots] button')];
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!track || slides.length < 2) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;

    function goTo(index: number) {
      const i = (index + slides.length) % slides.length; // da la vuelta al llegar al final
      track!.scrollTo({ left: slides[i].offsetLeft - track!.offsetLeft, behavior: reduce ? 'auto' : 'smooth' });
    }

    // Marca el punto activo según la diapositiva que se ve (también al deslizar a mano)
    function update() {
      const i = Math.round(track!.scrollLeft / track!.clientWidth);
      if (i === current) return;
      current = Math.max(0, Math.min(i, slides.length - 1));
      dots.forEach((d, j) => (j === current ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
    }

    prev?.addEventListener('click', () => goTo(current - 1));
    next?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((d, j) => d.addEventListener('click', () => goTo(j)));
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
  });
</script>

<style>
  .hero {
    /* Sombra suave en el centro, detrás del H1, para que se lea sobre las zonas claras de la foto */
    --hero-center-shade: radial-gradient(ellipse 55% 38% at 50% 42%, rgba(28, 15, 12, 0.6) 0%, rgba(28, 15, 12, 0) 100%);
    position: relative;
    isolation: isolate;
    /* Pantalla completa, por debajo de la cabecera transparente */
    margin-top: calc(-1 * var(--header-h));
    min-height: 100svh;
    display: flex;
    color: var(--color-text);
    background: var(--color-bg);
    overflow: hidden;
  }

  /* ---- Fondo ---- */
  .hero__bg,
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__bg :global(.film) { width: 100%; height: 100%; }
  /* Degradados del tema: oscuro a la izquierda (titular) y abajo (textos y carrusel).
     En móvil el titular ocupa todo el ancho: se añade sombra también arriba */
  .hero__shade {
    background:
      var(--hero-center-shade),
      linear-gradient(180deg, rgba(28, 15, 12, 0.7) 0%, rgba(28, 15, 12, 0) 55%),
      var(--gradient-photo-bottom),
      var(--gradient-photo);
  }

  .hero__inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
  }

  /* ---- Arriba: etiquetas + H1 ---- */
  .hero__top {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: calc(var(--header-h) + var(--space-3)) var(--space-5) 0;
  }
  .hero__labels {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }
  .hero__labels p,
  .hero__label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  /* H1 centrado. Tipografía de titulares del tema (--font-title, provisional) */
  .hero__title {
    margin: auto;
    padding-block: var(--space-6);
    max-width: 22ch;
    font-family: var(--font-title);
    font-weight: 600;
    /* 34px en móvil → 88px en pantallas grandes; limitado también por la altura */
    font-size: clamp(2.125rem, min(1rem + 4.6vw, 9.5svh), 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
  }
  /* "Entrena brava." en línea propia. En crema, no en ámbar: el ámbar sobre las
     zonas rojas de la foto no llega al contraste mínimo */
  .hero__tagline { display: block; }

  /* ---- Abajo: rejilla con líneas finas ---- */
  .hero__bottom {
    display: grid;
    border-top: 1px solid var(--color-border);
  }
  .hero__classes,
  .hero__pitch {
    padding: var(--space-5);
    min-width: 0;
  }
  .hero__pitch { border-top: 1px solid var(--color-border); }

  .hero__classes-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  /* Pista del carrusel: scroll horizontal con imán, sin barra visible */
  .hero__track {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .hero__track::-webkit-scrollbar { display: none; }
  .hero__slide {
    flex: 0 0 100%;
    display: flex;
    gap: var(--space-4);
    scroll-snap-align: start;
  }
  .hero__slide :global(.hero__thumb) {
    flex: 0 0 auto;
    width: 112px;
    aspect-ratio: 4 / 5;
  }
  .hero__slide-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }
  .hero__slide-name {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0 0 var(--space-1);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1;
    text-transform: uppercase;
  }
  .hero__slide-num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .hero__slide-meta {
    margin: 0 0 auto;
    padding-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  /* Botón secundario: contorno crema */
  .hero__book {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-5);
    border: 1px solid var(--color-text);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color var(--duration-base) var(--ease), color var(--duration-base) var(--ease);
  }
  .hero__book:hover {
    background: var(--color-text);
    color: var(--brava-red-intense);
  }

  /* Flechas redondas y puntos: solo con JavaScript (sin él, se desliza a mano) */
  .hero__controls,
  .hero__dots { display: none; }
  :global(.js) .hero__controls { display: flex; gap: var(--space-2); }
  :global(.js) .hero__dots { display: flex; gap: var(--space-1); margin-top: var(--space-3); }

  .hero__arrow {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    transition: border-color var(--duration-base) var(--ease), background-color var(--duration-base) var(--ease);
  }
  .hero__arrow:hover { border-color: var(--color-text); background: rgba(251, 237, 218, 0.08); }
  .hero__arrow--prev :global(svg) { transform: scaleX(-1); }

  /* Puntos: el área táctil es de 44px aunque el punto se vea pequeño */
  .hero__dot {
    position: relative;
    width: 28px;
    height: var(--tap);
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .hero__dot::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-text);
    opacity: 0.35;
    transform: translate(-50%, -50%);
    transition: opacity var(--duration-base) var(--ease), transform var(--duration-base) var(--ease);
  }
  .hero__dot[aria-current='true']::before { opacity: 1; transform: translate(-50%, -50%) scale(1.25); }

  /* ---- Entradilla ---- */
  .hero__pitch {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--space-5);
  }
  .hero__intro {
    margin: 0;
    max-width: 42ch;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  /* ---- Tableta: más aire; abajo sigue apilado (en dos columnas no cabe el carrusel) ---- */
  @media (min-width: 48rem) {
    .hero__shade { background: var(--hero-center-shade), var(--gradient-photo-bottom), var(--gradient-photo); }
    .hero__top { padding: calc(var(--header-h) + var(--space-4)) var(--space-7) 0; }
    .hero__classes { padding: var(--space-6) var(--space-7); }
    .hero__pitch {
      padding: var(--space-6) var(--space-7);
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  /* ---- Escritorio: abajo, dos columnas separadas por una línea ---- */
  @media (min-width: 64rem) {
    .hero__bottom { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .hero__classes { border-right: 1px solid var(--color-border); }
    .hero__pitch { border-top: 0; }
  }
</style>
