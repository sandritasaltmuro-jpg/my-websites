---
/**
 * Manifesto.astro (kit gym · Brava) — Sección "Manifiesto" (ref. "About the brand").
 * ---------------------------------------------------------------------------
 * - Arriba, una línea fina con etiquetas en mono (número de sección y nombre).
 * - Título H2 apilado y gigante en tres líneas escalonadas, montado sobre una
 *   franja horizontal de foto (09, sentadilla de perfil) con efecto película.
 * - Abajo a la derecha, el texto del manifiesto en mono.
 *
 * Uso: <Manifesto />  (textos por props, con los del concepto por defecto)
 *
 * Tipografía del H2: --font-title del tema (provisional, por decidir).
 * Fondo: --gradient-section + --gradient-glow. Contraste: crema sobre el degradado rojo (≥ 5:1); sobre la foto, la franja lleva una capa
 * oscura del tema para que el titular se lea siempre.
 */
import FilmImage from './FilmImage.astro';

interface Props {
  /** Las tres líneas del titular (se leen como una sola frase) */
  lines?: [string, string, string];
  text?: string;
}

const {
  lines = ['Aquí nadie', 'viene a', 'encogerse'],
  text = 'Venimos a levantar peso, a sudar, a subir a la barra y a ocupar todo el espacio. Con tacones o con zapatillas: fuerte es fuerte.',
} = Astro.props;
---

<section id="manifiesto" class="manifesto" aria-labelledby="manifiesto-title">
  <div class="manifesto__head" data-reveal="up">
    <p>01 · Manifiesto</p>
    <p aria-hidden="true">Brava Club · Malasaña</p>
  </div>

  <div class="manifesto__stage">
    <!-- Franja de foto detrás del titular -->
    <div class="manifesto__strip" data-reveal="image">
      <FilmImage
        num="09"
        alt="Mujer haciendo una sentadilla de perfil con una mancuerna cromada en cada mano"
        sizes="100vw"
        position="center 62%"
      />
    </div>

    <h2 id="manifiesto-title" class="manifesto__title" data-reveal="lines">
      {/* El espacio tras cada línea evita que los lectores de pantalla lean las palabras pegadas */}
      {lines.map((line, i) => <><span class={`manifesto__line manifesto__line--${i + 1}`}>{line}</span>{' '}</>)}
    </h2>
  </div>

  <div class="manifesto__foot">
    <p class="manifesto__aside" aria-hidden="true" data-reveal="up">Fuerza · Energía · Cuidado · Comunidad</p>
    <p class="manifesto__text" data-reveal="up">{text}</p>
  </div>
</section>

<style>
  .manifesto {
    position: relative;
    padding-block: var(--section-space);
    /* Rojo intenso → rojo Brava, con resplandor naranja arriba a la derecha */
    background: var(--gradient-glow), var(--gradient-section);
    color: var(--color-text);
    overflow: hidden;
  }

  /* ---- Etiquetas sobre línea fina ---- */
  .manifesto__head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-inline: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .manifesto__head p,
  .manifesto__aside {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ---- Titular apilado sobre la franja de foto ---- */
  .manifesto__stage {
    position: relative;
    display: grid;
    margin-block: var(--space-8);
  }
  /* La franja ocupa la línea central del titular y se sale por arriba y por abajo */
  .manifesto__strip {
    position: absolute;
    inset: 24% 0;
    z-index: 0;
  }
  .manifesto__strip :global(.film) { width: 100%; height: 100%; }
  /* Capa oscura cálida para que el titular crema se lea sobre la foto */
  .manifesto__strip::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(94, 37, 27, 0.6) 0%, rgba(150, 29, 19, 0.3) 50%, rgba(94, 37, 27, 0.6) 100%);
    pointer-events: none;
  }

  .manifesto__title {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding-inline: var(--space-5);
    font-family: var(--font-title);
    font-weight: 700;
    /* Gigante: 44px en móvil → 160px en pantallas grandes */
    font-size: clamp(2.75rem, 1rem + 9.5vw, 10rem);
    line-height: 0.88;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    text-wrap: nowrap;
  }
  /* Líneas escalonadas: izquierda, centro, derecha */
  .manifesto__line { display: block; }
  .manifesto__line--2 { align-self: center; }
  .manifesto__line--3 { align-self: flex-end; }

  /* ---- Texto del manifiesto ---- */
  .manifesto__foot {
    display: grid;
    gap: var(--space-5);
    margin-inline: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .manifesto__aside { opacity: 1; } /* crema: sobre el degradado rojo, la crema apagada no llega a 4,5 */
  /* En móvil sobra la etiqueta de la derecha: no cabe en una línea */
  @media (max-width: 47.99rem) {
    .manifesto__head p:last-child { display: none; }
  }
  .manifesto__text {
    margin: 0;
    max-width: 38ch;
    font-family: var(--font-mono);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
  }

  /* ---- Tableta y escritorio ---- */
  @media (min-width: 48rem) {
    .manifesto__head,
    .manifesto__foot { margin-inline: var(--space-7); }
    .manifesto__title { padding-inline: var(--space-7); }
    .manifesto__stage { margin-block: var(--space-9); }
    .manifesto__foot {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
    .manifesto__text {
      justify-self: end;
      font-size: var(--text-lg);
    }
  }
</style>
