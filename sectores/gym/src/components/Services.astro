---
/**
 * Services.astro — Tarjetas de servicios. Cada servicio lleva su H3.
 * Datos concretos (precio orientativo, duración) ayudan al cliente y a las búsquedas con IA.
 *
 * Uso:
 *   <Services items={[{ title: 'Corte', text: '...', price: 'Desde 25 €', duration: '45 min' }]} />
 */
interface Item {
  title: string;
  text: string;
  price?: string;
  duration?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<ul class="services" role="list">
  {items.map((item) => (
    <li class="service">
      <h3 class="service__title">{item.title}</h3>
      <p class="service__text">{item.text}</p>
      {(item.price || item.duration) && (
        <p class="service__meta">
          {item.price && <span>{item.price}</span>}
          {item.duration && <span>{item.duration}</span>}
        </p>
      )}
    </li>
  ))}
</ul>

<style>
  .services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .service {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .service__title { margin-bottom: var(--space-2); }
  .service__text { color: var(--color-muted); flex: 1; }
  .service__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>
