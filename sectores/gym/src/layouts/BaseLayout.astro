---
/**
 * BaseLayout.astro — Estructura común a todas las páginas:
 * <head> con SEO y datos para Google, header, contenido, footer y botón de WhatsApp.
 *
 * Uso en una página:
 *   <BaseLayout title="Peluquería en Chamberí | Estudio Lúa" description="...">
 *     ...secciones...
 *   </BaseLayout>
 */
import SEO from '../components/SEO.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Preloader from '../components/Preloader.astro';
// Fuentes del tema, alojadas en la propia web (sin peticiones a Google)
import '@fontsource/anton';
import '@fontsource-variable/archivo';
import '@fontsource/space-mono';
import '@fontsource-variable/inter-tight'; // titulares H1/H2 (estilo suizo)
import '../styles/tokens.css';
import '../styles/base.css';
// Tema activo: cambia esta línea para usar otro (ver src/themes/README.md)
import '../themes/brava.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Botón flotante de WhatsApp. DESACTIVADO por defecto: Brava es una landing de escaparate
   *  y las llamadas a la acción se definirán más adelante (decisión 20 nov) */
  showWhatsAppFloat?: boolean;
  /** Pantalla de carga (solo primera visita). Desactivar en páginas legales */
  showPreloader?: boolean;
}

const { showWhatsAppFloat = false, showPreloader = true, ...seo } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO {...seo} />
    <LocalBusinessSchema />
    <!-- Decide ANTES de pintar: clase "js" y si se muestra la pantalla de carga
         (solo primera visita de la sesión y sin "reducir movimiento") -->
    <script is:inline define:vars={{ showPreloader }}>
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        try {
          var seen = sessionStorage.getItem('brava-loaded');
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (showPreloader && !seen && !reduce) h.classList.add('is-loading');
        } catch (e) {}
      })();
    </script>
    <!-- Espacio para fuentes del tema u otras etiquetas de una página concreta -->
    <slot name="head" />
  </head>
  <body>
    {showPreloader && <Preloader />}
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    {showWhatsAppFloat && <WhatsAppFloat />}
    <script>
      // Entradas animadas con GSAP (ver src/scripts/animations.ts)
      import { initAnimations } from '../scripts/animations';
      import { announceReady } from '../scripts/preloader';
      // Si la página no tiene pantalla de carga, avisa de que está lista
      if (!document.querySelector('[data-preloader]')) announceReady();
      initAnimations();
    </script>
  </body>
</html>
