---
/**
 * index.astro — Brava Club (concepto del kit gym). EN CONSTRUCCIÓN.
 * Aquí irán los componentes de gym a medida que se diseñen:
 * hero editorial, manifiesto, clases, wellness, horario, tarifas, equipo, galería, FAQ y llamada final.
 * Contenido: claude/concepto-gym-girls.md (proyecto).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout title={`Gimnasio para mujeres en Madrid | ${site.name}`} description={site.description}>
  <section class="container wip">
    <h1 data-reveal="lines">Gimnasio para mujeres en Madrid. Entrena brava.</h1>
    <p data-reveal="up">Web en construcción.</p>
  </section>
</BaseLayout>

<style>
  .wip { padding-block: var(--space-9); }
  .wip h1 { font-family: var(--font-display); font-weight: 400; font-size: var(--text-3xl); text-transform: uppercase; }
  .wip p { color: var(--color-muted); font-family: var(--font-mono); font-size: var(--text-sm); }
</style>
