---
/**
 * index.astro — Brava Club (concepto del kit gym). EN CONSTRUCCIÓN.
 * Las secciones se van añadiendo en el orden de CLAUDE.md:
 * Hero → Manifiesto → Clases + Hot → El estudio → Wellness → Horario → Tarifas
 * → Equipo → You + Brava → FAQ unido al pie.
 * Contenido y textos: docs/brava-concepto.md.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Clases from '../components/Clases.astro';
import Estudio from '../components/Estudio.astro';
import Wellness from '../components/Wellness.astro';
import Horario from '../components/Horario.astro';
import Tarifas from '../components/Tarifas.astro';
import Equipo from '../components/Equipo.astro';
import Comunidad from '../components/Comunidad.astro';
import { site } from '../config/site';
---

<BaseLayout title={`Gimnasio para mujeres en Madrid | ${site.name}`} description={site.description}>
  <Hero />
  <Manifesto />
  <Clases />
  <Estudio />
  <Wellness />
  <Horario />
  <Tarifas />
  <Equipo />
  <Comunidad />
</BaseLayout>
