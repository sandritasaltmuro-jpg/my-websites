---
/**
 * 404.astro — Página para direcciones que no existen.
 * noindex: no debe aparecer en Google.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { site } from '../config/site';
---

<BaseLayout title={`Página no encontrada | ${site.name}`} description="Esta página no existe." noindex>
  <section class="container container--narrow not-found">
    <p class="not-found__code">404</p>
    <h1>No encontramos esta página</h1>
    <p>Puede que el enlace esté mal escrito o que la página ya no exista.</p>
    <Button href="/" icon="arrow">Volver al inicio</Button>
  </section>
</BaseLayout>

<style>
  .not-found { padding-block: var(--space-9); }
  .not-found__code {
    font-family: var(--font-mono);
    color: var(--color-accent);
    letter-spacing: 0.1em;
    margin-bottom: var(--space-2);
  }
</style>
